# ============================================================
#  AI Gym & Fitness Assistant - environment variables
#  Copy this file to  backend/.env  and fill in real values.
#  NEVER commit the real .env file.
# ============================================================

# --- Core API ---
# Leave DATABASE_URL blank to use a local SQLite file (zero setup).
# For Postgres locally:
#   DATABASE_URL=postgresql+psycopg://gymuser:gympass@localhost:5432/gymdb
DATABASE_URL=

# Secret used to sign JWT login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of front-end origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB (OPTIONAL: stores raw landmark time-series) ---
# Blank => the app runs fine, raw frames are simply not archived.
# Free cluster: https://www.mongodb.com/cloud/atlas/register
MONGO_URL=
MONGO_DB=aigym

# --- MQTT (OPTIONAL: ESP32 + MPU6050 IMU stream) ---
# Blank => the IMU path falls back to the HTTP endpoint /api/imu/ingest.
# Free public test broker: broker.emqx.io : 1883  (no auth, not private)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=0
MQTT_TOPIC=gym/+/imu

# --- LLM coach (OPTIONAL) ---
# Blank => chat_service uses the deterministic rule-based coach (still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
